    "@language" : "en",
    "@value" : "A neighborhood is each of the parts into which large towns or their districts are divided [source: DRAE 2011]."
  }, {
    "@language" : "es",
    "@value" : "Un barrio es cada una de las partes en que se dividen los pueblos grandes o sus distritos [fuente: DRAE 2011]."
  } ],
