  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://www.w3.org/TR/vocab-data-cube/MeasureProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Total number national, international, and interprovincial tourists that pass through a tourist site."
  }, {
    "@language" : "es",
    "@value" : "Total number of national, international and interprovincial tourists passing through a tourist site."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "number of tourists"
  }, {
    "@language" : "es",
    "@value" : "número de turistas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
