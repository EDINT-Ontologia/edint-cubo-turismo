<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/cubo-turismo#"
     xml:base="https://edint.es/def/cubo-turismo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/widoco/vocab#"
     xmlns:schema="https://schema.org/"
     xmlns:vocab-data-cube="https://www.w3.org/TR/vocab-data-cube/">
    <owl:Ontology rdf:about="https://edint.es/def/cubo-turismo">
        <owl:versionIRI rdf:resource="https://edint.es/def/cubo-turismo/0.2.1"/>
        <owl:imports rdf:resource="https://www.w3.org/TR/vocab-data-cube/"/>
        <terms:abstract xml:lang="es">La ontología de Cubo de Datos Turísticos describe la estructura que contiene las dimensiones y medidas que pueden ser utilizadas para generar cubos de datos turísticos. Algunos ejemplos de cubos son los de ocupación turística, flujo turístico y los de indicadores que permiten evaluar aspectos como ocupación promedio, crecimiento en número de plazas,  crecimiento de flujo turístico, etc. Para desarrollar el cubo de datos turísticos se reutiliza el vocabulario W3C Data Cube.</terms:abstract>
        <terms:abstract xml:lang="en">The Tourism Data Cube ontology describes the structure containing the dimensions and measures that can be used to generate tourism data cubes. Examples of such cubes include those for tourist occupancy, tourist flow, and indicators that allow for the evaluation of aspects like average occupancy, growth in the number of accommodations, growth in tourist flow, etc. The W3C Data Cube vocabulary was reused to develop the tourism data cube.</terms:abstract>
        <terms:bibliographicCitation xml:lang="es">Cubo de Datos EDINT de Turismo. EDINT. Revisión: v0.2.1.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="en">EDINT Tourism Data Cube. EDINT. Revision: v0.2.1.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-17</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:creator rdf:nodeID="genid6"/>
        <terms:description xml:lang="es">La ontología de Cubo de Datos Turísticos describe la estructura de los datos de ocupación turística, flujo turístico e indicadores en un único DSD que reúne todas las dimensiones y medidas.</terms:description>
        <terms:description xml:lang="en">The Tourism Data Cube ontology describes the structure of tourist occupancy, tourist flow and indicator data in a single DSD that gathers all dimensions and measures.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:modified>
        <terms:publisher rdf:nodeID="genid7"/>
        <terms:title xml:lang="es">Cubo de Datos EDINT de Turismo</terms:title>
        <terms:title xml:lang="en">EDINT Tourism Data Cube</terms:title>
        <vann:preferredNamespacePrefix>edinttur</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/cubo-turismo#"/>
        <rdfs:label xml:lang="es">Cubo de Datos de Turismo</rdfs:label>
        <rdfs:label xml:lang="en">Tourism Data Cube</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-cubo-turismo/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-cubo-turismo"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <vocab:jsonldSerialization>ontology.jsonld</vocab:jsonldSerialization>
        <vocab:ntSerialization>ontology.nt</vocab:ntSerialization>
        <vocab:rdfxmlSerialization>ontology.rdf</vocab:rdfxmlSerialization>
        <vocab:turtleSerialization>ontology.ttl</vocab:turtleSerialization>
        <vocab:vocabularyLabel rdf:nodeID="genid8"/>
        <vocab:vocabularyLabel rdf:nodeID="genid9"/>
        <vocab:vocabularyLabel rdf:nodeID="genid10"/>
        <vocab:vocabularyLabel rdf:nodeID="genid11"/>
        <vocab:vocabularyLabel rdf:nodeID="genid12"/>
        <vocab:vocabularyLabel rdf:nodeID="genid13"/>
        <vocab:vocabularyLabel rdf:nodeID="genid14"/>
    </owl:Ontology>
